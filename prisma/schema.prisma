// =============================================================================
// Haiwan CRM — Prisma Schema
// SQLite · Prisma ORM · Next.js App Router
//
// MIGRATION HANDOFF NOTE (for the future outsourced team):
//   • Phone numbers are stored in canonical Malaysian format: "60xxxxxxxxx"
//     (country code + digits, no +, no spaces, no dashes).
//   • The Pet is the core entity. TransactionLine.petId links each line item
//     to the specific pet it was purchased for, enabling per-pet analytics.
//   • product.isConsumable = true marks items eligible for refill prediction.
//   • product.supplierType drives the revenue-mix dashboard (TRADING |
//     CONSIGNMENT | INHOUSE).
//   • customer.needsDetails = true flags stub records auto-created during
//     StoreHub CSV import — staff should fill in names etc.
//   • The SQLite file lives at ../data/haiwan.db relative to this schema.
//     On Railway/Render, mount a persistent volume at that path.
// =============================================================================

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

// Which physical store the transaction occurred at, or the customer prefers.
// NONE means no preference recorded yet.
enum Store {
  KL
  PJ
  NONE
}

// How we first captured this customer.
enum CustomerSource {
  STOREHUB   // auto-created from a POS import
  WHATSAPP   // captured via WhatsApp conversation
  WALKIN     // staff manually entered at the counter
  TYPEFORM   // submitted a Typeform customer/pet details form
  OTHER
}

// Membership lifecycle (Phase 2) — the spine other systems read from.
//   PROSPECT = has records but hasn't claimed (no consent / stub)
//   ACTIVE   = claimed: consent given + a confirmed profile (>=1 pet)
//   LAPSED   = was ACTIVE but no purchase in LAPSED_AFTER_DAYS (auto-winback)
enum MemberStatus {
  PROSPECT
  ACTIVE
  LAPSED
}

// Pet species.
enum Species {
  DOG
  CAT
  OTHER
}

// Life stage of the pet — set manually or derived from age.
enum LifeStage {
  PUPPY_KITTEN  // < ~12 months
  ADULT
  SENIOR
}

// Pet sex.
enum Sex {
  MALE
  FEMALE
  UNKNOWN
}

// Which species a product targets.
enum TargetSpecies {
  DOG
  CAT
  ANY
}

// Life stage a product targets.
enum ProductLifeStage {
  PUPPY_KITTEN
  ADULT
  SENIOR
  ANY
}

// Unit of measure for pack size.
enum PackUnit {
  G
  KG
  ML
  L
  COUNT
}

// Where Haiwan sources the product — the key dimension for the revenue-mix
// north-star chart.
//   TRADING     = bought and resold (lowest margin)
//   CONSIGNMENT = supplier owns stock, Haiwan takes a cut
//   INHOUSE     = Haiwan's own brand (highest margin, strategic priority)
enum SupplierType {
  TRADING
  CONSIGNMENT
  INHOUSE
}

// Subscription lifecycle state.
enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

// --- Supplier / consignment pipeline (Phase 4) -------------------------------

// How Haiwan works with a brand partner. Extends the product SupplierType with
// CO_CREATION (a jointly developed line — the strategic end-goal of a trial).
enum BrandSupplierType {
  TRADING
  CONSIGNMENT
  INHOUSE
  CO_CREATION
}

// Where a brand sits in the partnership pipeline.
enum BrandStatus {
  PROSPECT
  IN_TALKS
  TRIAL
  ACTIVE
  DROPPED
}

// Brand-fit against Haiwan's aesthetic/positioning, from the sourcing review.
enum AestheticFit {
  HIGH
  CONDITIONAL
  VERIFY
  SKIP
}

// Direction of a WhatsApp message relative to Haiwan.
//   INBOUND  = customer -> Haiwan
//   OUTBOUND = Haiwan  -> customer
enum MessageDirection {
  INBOUND
  OUTBOUND
}

// Which ingestion adapter produced a message. Lets us swap the live source
// later (official Cloud API / unofficial bridge / a BSP provider) without
// touching the storage or analysis layers.
enum WhatsAppSource {
  MANUAL      // pasted/imported chat export (the fallback that works today)
  CLOUD_API   // Meta WhatsApp Business Platform webhook
  BRIDGE      // unofficial web bridge (e.g. whatsapp-web.js)
  PROVIDER    // a BSP/provider (Twilio, Wati, 360dialog, …)
}

// What the EOD analysis decided a message thread represents.
enum LeadType {
  ORDER             // an explicit order/purchase request
  REFILL            // a top-up / restock of a consumable they already buy
  PURCHASE_INTENT   // interest / "do you have…", price asks — not yet committed
  INQUIRY           // general question, no buying signal
  COMPLAINT         // problem / dissatisfaction to follow up
  OTHER
}

// Review state of an extracted lead in the staff queue.
enum LeadStatus {
  PENDING    // awaiting staff review
  CONFIRMED  // staff acknowledged / actioned
  DISMISSED  // not actionable / false positive
}

// --- Action Inbox (Phase 1) ---------------------------------------------------

// What kind of work a Task represents. Drives its WhatsApp template + icon.
enum TaskType {
  REFILL            // a consumable predicted to run low (usually surfaced via the
                    // refill engine + RefillOverlay, but CUSTOM/manual REFILLs allowed)
  LEAD_FOLLOWUP     // a walk-in/asked-about-an-item lead to chase (SOP §5)
  INQUIRY           // an inbound question from WhatsApp/website/Instagram
  HOLD              // a 24h item hold to convert before it lapses (SOP §6)
  ACTIVATION        // nudge a PROSPECT to claim membership (Phase 2)
  WINBACK           // re-engage a lapsed customer (Phase 2)
  SUBSCRIPTION_DUE  // a managed subscription due for its next cycle (Phase 3)
  BRAND_REVIEW      // a brand 90-day trial review (Phase 4)
  CUSTOM            // anything staff types in manually
}

// Where the task originated — shown as a channel tag in the inbox.
enum TaskChannel {
  WALKIN
  WHATSAPP
  WEBSITE
  INSTAGRAM
  SYSTEM
}

// Lifecycle of a task in the inbox.
enum TaskStatus {
  OPEN
  DONE
  SNOOZED
  EXPIRED
}

// Which mechanism created the task (for auditing + export).
enum TaskSource {
  REFILL_ENGINE
  SOP_LEAD
  SOP_HOLD
  SYSTEM
  MANUAL
}

// ---------------------------------------------------------------------------
// Customer — the human contact and payer.
// Phone is the identity key: unique, normalised to "60xxxxxxxxx" format.
// ---------------------------------------------------------------------------
model Customer {
  id               String         @id @default(cuid())
  phone            String         @unique  // canonical: "60123456789"
  name             String?
  email            String?
  preferredStore   Store          @default(NONE)
  marketingConsent Boolean        @default(false)  // PDPA opt-in
  consentDate      DateTime?
  source           CustomerSource @default(STOREHUB)
  // true = stub record auto-created from import; staff should enrich later
  needsDetails     Boolean        @default(false)
  notes            String?

  // Historical RFM figures imported from the StoreHub POS export. These are
  // lifetime summaries (no line items), used to seed RFM for customers whose
  // purchases predate this CRM. When present they take precedence over locally
  // recorded transactions in RFM (avoids double-counting the same sale).
  posSpent         Float?
  posTransactions  Int?
  posLastPurchase  DateTime?

  // --- Membership spine (Phase 2) ---------------------------------------------
  // memberStatus is the field everything else reads from. memberId is assigned
  // (HW-#####) when a customer is activated/claimed. tier is computed, not stored.
  memberStatus     MemberStatus  @default(PROSPECT)
  // Assigned (HW-#####) on activation. Uniqueness is enforced in app code
  // (lib/membership.ts) rather than a DB UNIQUE constraint, so this stays a
  // plain additive column — no destructive table rebuild on existing data.
  memberId         String?
  joinDate         DateTime?     // first became a member
  claimedDate      DateTime?     // when they claimed/activated (consent + profile)
  pointsBalance    Int           @default(0)
  // StoreHub loyalty points captured at sync, for reconciliation only (the CRM's
  // computed tier is the source of truth; this just flags divergence).
  posLoyaltyPoints Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pets             Pet[]
  transactions     Transaction[]
  subscriptions    Subscription[]
  whatsappMessages WhatsAppMessage[]
  whatsappLeads    WhatsAppLead[]
  tasks            Task[]
  refillOverlays   RefillOverlay[]

  @@index([memberId])
}

// ---------------------------------------------------------------------------
// Pet — the central entity of the CRM.
// Every customer can have multiple pets; analytics and predictions are
// computed per-pet wherever possible.
// ---------------------------------------------------------------------------
model Pet {
  id             String     @id @default(cuid())
  customerId     String
  customer       Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)

  name           String
  // Photo of the pet (stored as a downscaled data URL). Shown on the pets list
  // and the pet profile.
  photoUrl       String?
  species        Species
  breed          String?
  sex            Sex?
  // Spayed / neutered — relevant for diet and health guidance
  neutered       Boolean    @default(false)
  dateOfBirth    DateTime?
  // Fallback when exact DOB is unknown; staff enters approximate age in months
  approxAgeMonths Int?
  // "Gotcha day" — when this pet joined the family (on-brand for "another parent")
  adoptionDate   DateTime?
  weightKg       Float?
  // Manual life-stage override; if null, derive from age
  lifeStage      LifeStage?
  // Coat colour / distinguishing markings
  colorMarkings  String?
  // Microchip number, if known
  microchipId    String?
  // Regular vet / clinic
  vetName        String?
  dietaryNotes   String?
  allergies      String?
  // General free-text notes about the pet (temperament, preferences, etc.)
  notes          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactionLines TransactionLine[]
  subscriptions    Subscription[]
  tasks            Task[]
}

// ---------------------------------------------------------------------------
// Product — the item catalog.
// isConsumable = true enables refill prediction for this product.
// supplierType drives the revenue-mix chart.
// ---------------------------------------------------------------------------
model Product {
  id            String           @id @default(cuid())
  sku           String           @unique
  name          String
  brand         String?  // legacy free-text brand label; kept as-is
  // FK to Brand (Phase 4). App-side join (no DB relation) so this stays an
  // additive column — see lib/brands.ts. Backfilled from `brand` by name.
  brandId       String?
  // Free-text category: food, litter, treat, accessory, bed, supplement, …
  category      String
  targetSpecies TargetSpecies    @default(ANY)
  lifeStage     ProductLifeStage @default(ANY)
  packSize      Float?
  packUnit      PackUnit?
  // TRADING | CONSIGNMENT | INHOUSE — drives the north-star revenue-mix chart
  supplierType  SupplierType     @default(TRADING)
  costPrice     Float?
  retailPrice   Float?
  // Only consumables (food, litter) get refill-due predictions
  isConsumable  Boolean          @default(false)

  // On-hand stock per outlet (from the StoreHub export). Total available =
  // stockKL + stockPJ. Kept as legacy reference once Wix sync is live.
  stockKL       Int              @default(0)
  stockPJ       Int              @default(0)

  // --- Wix inventory sync (Wix is the source of truth for on-hand stock) ---
  // Wix has no SKUs, so products are matched by name on first sync; the matched
  // Wix product id is stored for fast, exact re-syncs afterwards. wixStock is
  // the authoritative total on-hand (Wix tracks one pool, not per-store).
  wixProductId  String?          @unique
  wixStock      Int?
  wixSyncedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines         TransactionLine[]
  subscriptions Subscription[]
  tasks         Task[]
  refillOverlays RefillOverlay[]

  @@index([brandId])
}

// ---------------------------------------------------------------------------
// Transaction — a sales event (one receipt / basket).
// customerId is nullable: unmatched transactions are stored but not yet linked.
// ---------------------------------------------------------------------------
model Transaction {
  id              String    @id @default(cuid())
  customerId      String?
  customer        Customer? @relation(fields: [customerId], references: [id])

  store           Store
  transactionDate DateTime
  // StoreHub receipt reference — used for deduplication on re-import
  storehubRef     String?
  // Phone as it appeared in the raw CSV, kept for debugging match failures
  rawPhone        String?
  totalAmount     Float

  createdAt DateTime @default(now())

  lines TransactionLine[]
}

// ---------------------------------------------------------------------------
// TransactionLine — one line item within a transaction.
// petId: which pet this item is for (enables per-pet refill prediction).
// productId: nullable if the SKU/name couldn't be matched to the catalog.
// rawProductName: always kept so unmatched lines can be resolved later.
// ---------------------------------------------------------------------------
model TransactionLine {
  id            String       @id @default(cuid())
  transactionId String
  transaction   Transaction  @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  productId     String?
  product       Product?     @relation(fields: [productId], references: [id])

  // Which pet this line item is for (optional; enriched by staff post-import)
  petId         String?
  pet           Pet?         @relation(fields: [petId], references: [id])

  // Raw product name from the import; preserved even when productId is matched
  rawProductName String
  quantity       Float
  unitPrice      Float
  lineTotal      Float
}

// ---------------------------------------------------------------------------
// Subscription — recurring order intent; basic CRUD only for now.
// ---------------------------------------------------------------------------
model Subscription {
  id          String             @id @default(cuid())
  customerId  String
  customer    Customer           @relation(fields: [customerId], references: [id])

  petId       String?
  pet         Pet?               @relation(fields: [petId], references: [id])

  productId   String
  product     Product            @relation(fields: [productId], references: [id])

  intervalDays Int
  nextDueDate  DateTime
  status       SubscriptionStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// WhatsAppMessage — one inbound or outbound WhatsApp message.
//
// Storage is deliberately source-agnostic: messages arrive via an ingestion
// adapter (manual chat-export paste today; Cloud API / bridge / provider later)
// and are normalised into this single table. customerId is nullable — a message
// from an unknown number is still stored and linked once the customer exists.
// `phone` is canonical "60xxxxxxxxx" so it matches Customer.phone.
// `externalId` (when the source provides one) makes re-ingestion idempotent.
// ---------------------------------------------------------------------------
model WhatsAppMessage {
  id          String           @id @default(cuid())
  customerId  String?
  customer    Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)

  phone       String           // canonical "60xxxxxxxxx"
  rawPhone    String?          // as it arrived, for debugging match failures
  contactName String?          // WhatsApp profile / saved name, if known
  direction   MessageDirection @default(INBOUND)
  body        String
  timestamp   DateTime         // when the message was sent
  source      WhatsAppSource   @default(MANUAL)
  externalId  String?          @unique // provider message id, for dedup

  // Set once the EOD analysis has processed this message, so re-runs don't
  // re-analyse the same backlog.
  analyzedAt  DateTime?

  createdAt   DateTime         @default(now())

  @@index([phone])
  @@index([timestamp])
  @@index([customerId])
  @@index([analyzedAt])
}

// ---------------------------------------------------------------------------
// WhatsAppLead — a structured signal extracted by the EOD analysis from one
// customer's messages for a given day. Lands in a staff review queue.
//
// `evidence` holds the source message snippets the model reasoned over, so
// staff can verify. `itemsJson` holds the structured line items the model
// proposed (product name, qty, matched SKU/productId if found) as JSON.
// ---------------------------------------------------------------------------
model WhatsAppLead {
  id           String     @id @default(cuid())
  customerId   String?
  customer     Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)

  phone        String     // canonical, even when no customer record yet
  contactName  String?

  type         LeadType
  // One-line, human-readable summary of what the customer wants.
  summary      String
  // Structured items the model proposed: JSON array of
  // { productName, quantity, matchedProductId?, matchedSku? }.
  itemsJson    String?
  // Source message snippets the lead was derived from (newline-joined).
  evidence     String?
  // Model confidence 0..1.
  confidence   Float      @default(0)

  status       LeadStatus @default(PENDING)
  // The business day this lead was analysed for (date-only semantics).
  analysisDate DateTime

  createdAt    DateTime   @default(now())
  reviewedAt   DateTime?

  @@index([status])
  @@index([analysisDate])
  @@index([customerId])
}

// ---------------------------------------------------------------------------
// Task — the Action Inbox spine (Phase 1).
//
// A single, dueAt-sorted list of "what to do now" that staff work from. Tasks
// are created manually (SOP lead capture / 24h hold / inquiry intake) or spawned
// by the system (hold-lapse follow-ups; later phases add activation, win-back,
// subscription-due, brand-review). Refill predictions are NOT stored here — they
// stay computed on the fly in lib/refill.ts and carry their done/snooze state in
// RefillOverlay; the inbox merges the two at read time.
//
// All FKs are nullable + onDelete SetNull so deleting a customer/pet/product
// never destroys the audit trail of work that was done.
// ---------------------------------------------------------------------------
model Task {
  id         String      @id @default(cuid())
  type       TaskType
  source     TaskSource  @default(MANUAL)
  channel    TaskChannel @default(SYSTEM)
  // Which store this task belongs to (reuses the shared Store enum). Defaults to
  // the customer's preferredStore, or NONE when unknown.
  store      Store       @default(NONE)

  customerId String?
  customer   Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  petId      String?
  pet        Pet?        @relation(fields: [petId], references: [id], onDelete: SetNull)
  productId  String?
  product    Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  // BRAND_REVIEW tasks (Phase 4) point at a Brand instead of a customer.
  // App-side join (no DB relation) to keep this an additive column.
  brandId    String?

  // When this task is due / its first-reply deadline. Drives inbox ordering.
  dueAt      DateTime
  status     TaskStatus  @default(OPEN)
  note       String?

  // HOLD-only: the item being held and when the 24h reservation lapses.
  holdItem      String?
  holdExpiresAt DateTime?

  // SNOOZED-only: hidden from the open inbox until this moment passes.
  snoozedUntil  DateTime?

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([status, dueAt])
  @@index([customerId])
  @@index([brandId])
}

// ---------------------------------------------------------------------------
// RefillOverlay — done/snooze state for a computed refill prediction (Phase 1).
//
// Refills are predicted live (never stored), so to let staff clear one without
// it reappearing we store ONLY the overlay state here, keyed by (customer,
// product). `cycleDate` records the predictedNextDate the action was taken
// against: when the customer buys again the live prediction moves to a new
// cycleDate, the overlay no longer matches, and the refill correctly reappears.
// ---------------------------------------------------------------------------
model RefillOverlay {
  id         String     @id @default(cuid())
  customerId String
  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  String
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  // The predicted-next-purchase date this overlay applies to (the "cycle key").
  cycleDate    DateTime
  // DONE = cleared for this cycle; SNOOZED = hidden until snoozedUntil.
  status       TaskStatus @default(DONE)
  snoozedUntil DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([customerId, productId])
  @@index([customerId])
}

// ---------------------------------------------------------------------------
// Brand — a supplier/brand partnership tracked inside the CRM (Phase 4), so
// keep/drop decisions are driven by real sell-through instead of a spreadsheet.
// Products link via Product.brandId (app-side join). Trial brands get a
// BRAND_REVIEW task at day 90 (see lib/brands.ts).
// ---------------------------------------------------------------------------
model Brand {
  id             String            @id @default(cuid())
  name           String            @unique
  website        String?
  country        String?
  supplierType   BrandSupplierType @default(TRADING)
  status         BrandStatus       @default(PROSPECT)
  owner          String?           // team member: Dini | Jeany | Dannie | Win Nie | Evi
  nextStep       String?
  listingFee     Float?            // deal terms: upfront listing fee (RM)
  commissionPct  Float?            // deal terms: commission % (consignment)
  trialStartDate DateTime?         // start of the 90-day trial window
  aestheticFit   AestheticFit?
  notes          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

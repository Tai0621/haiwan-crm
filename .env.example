# =============================================================================
# Haiwan CRM — environment variables
# Copy to .env for local dev. In production (Vercel), set these in the
# project's Environment Variables UI instead of committing them.
# =============================================================================

# --- Database -----------------------------------------------------------------
# Local dev: a SQLite file (relative to the app dir).
DATABASE_URL="file:../data/haiwan.db"
#
# Production (Turso): use the libsql URL + auth token from `turso db show`.
#   DATABASE_URL="libsql://haiwan-<you>.turso.io"
#   DATABASE_AUTH_TOKEN="<token from: turso db tokens create haiwan>"

# --- Auth: shared team passwords (two roles) ----------------------------------
# APP_PASSWORD       = management login (sees everything).
# APP_PASSWORD_STAFF = frontline staff login (Inbox + Customers + Transactions
#                      only). Leave empty to disable the frontline account.
# The password entered at login decides the role. Use long random strings in
# production (the dev values below are only for local use).
APP_PASSWORD="haiwan2024"
APP_PASSWORD_STAFF="staff2024"

# --- Claude (WhatsApp end-of-day analysis) ------------------------------------
# Required for lead extraction. Without it, analysis returns gracefully with a
# "key not set" message and creates no leads.
ANTHROPIC_API_KEY=""
# Optional model override (default: claude-haiku-4-5)
WHATSAPP_ANALYSIS_MODEL=""

# --- Cron protection ----------------------------------------------------------
# A random secret. Vercel Cron sends it as a Bearer token so only Vercel can
# trigger /api/cron/eod-analysis. Generate one, e.g.:  openssl rand -hex 32
CRON_SECRET=""

# --- Misc ---------------------------------------------------------------------
NEXT_TELEMETRY_DISABLED=1
# Note: the server runs in UTC (Vercel reserves TZ). Haiwan is Malaysia-only, so
# dates are rendered + bucketed in Asia/Kuala_Lumpur explicitly in code
# (lib/format.ts) rather than via a runtime timezone.
